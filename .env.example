# NEAR account whose NEAR Intents balance receives the settled USDC (public, not a secret).
# The placeholder works for demo quotes. Set your own account before anyone sends real USDC.
RECIPIENT_NEAR_ACCOUNT=your-account.tg
# Required: how many NGN per 1 USD. Quotes use it. Update it to the current rate before taking real payments.
NGN_PER_USD=1200
# Safety margin added on top of the NGN amount, in percent
MARGIN_PCT=2
# Origin chains customers may pay from. Empty = all: arb,base,eth,op,pol,bsc,sol,near (all dry-quote OK on 2026-11-07)
SUPPORTED_ORIGINS=
# true = enables POST /api/dev/orders/:id/simulate-paid so the flow can be demoed without real funds
DEMO_MODE=true
PORT=3000
# Used only by `npm run quote` (dry-quote probe) as the refund address on EVM chains; any valid 0x address works.
REFUND_EVM_ADDRESS=0x1111111111111111111111111111111111111111
# Used only by `npm run quote` as the refund account for NEAR. It must be an existing NEAR account (1Click rejects unknown ones).
REFUND_NEAR_ACCOUNT=intents.near
# Optional. Not required (0.2% fee without one).
ONECLICK_JWT=
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# Airtime provider: mock (default, fake deliveries) or topupbox (real airtime, spends wallet balance)
VTU_PROVIDER=mock
# TopupBox access token (secret). Regenerate on the TopupBox dashboard; it expires after a year.
TOPUPBOX_TOKEN=
# Live: https://api.topupbox.com/services   Sandbox: https://sandbox-api.topupbox.com/services
TOPUPBOX_BASE_URL=https://api.topupbox.com/services
# Authorization header format. TopupBox accepts the bare token (raw); "Bearer <token>" gets 401.
TOPUPBOX_AUTH=raw
# tariffTypeId is a required field; for AIRTIME the docs give no value. Leave empty to send "0".
TOPUPBOX_AIRTIME_TARIFF_ID=
# Safety limits. Creating orders/batches per client IP per minute, and orders + batches waiting for payment at once.
ORDER_RATE_LIMIT=10
MAX_OPEN_ORDERS=100
# Set behind a reverse proxy so rate limits use the client IP (e.g. 1 = trust one proxy hop)
TRUST_PROXY=
# NOTE: DEMO_MODE=true is only allowed with VTU_PROVIDER=mock; the server refuses to start otherwise.
